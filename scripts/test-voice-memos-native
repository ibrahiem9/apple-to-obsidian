#!/usr/bin/env python3
"""Synthetic, local-only regression tests for the native Voice Memos helper."""
import hashlib
import json
import os
from pathlib import Path
import sqlite3
import subprocess
import tempfile
import time
import unittest
import wave

ROOT = Path(__file__).resolve().parent.parent
HELPER = Path(os.environ.get('APPLE_TO_OBSIDIAN_VOICE_HELPER', ROOT / 'native/.build/release/voice-memos'))


class NativeTests(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix='voice-native-test-')
        self.root = Path(self.temporary.name)
        self.library = self.root / 'library'
        self.library.mkdir()
        self.db = sqlite3.connect(self.library / 'CloudRecordings.db')
        self.db.execute('PRAGMA journal_mode=WAL')
        self.db.execute('PRAGMA wal_autocheckpoint=0')
        self.db.execute('''CREATE TABLE ZCLOUDRECORDING (
            Z_PK INTEGER PRIMARY KEY, ZFLAGS INTEGER, ZSHAREDFLAGS INTEGER,
            ZAUDIOFUTUREFLAGS INTEGER, ZDATE REAL, ZDURATION REAL,
            ZEVICTIONDATE REAL, ZLOCALDURATION REAL, ZCUSTOMLABEL TEXT,
            ZENCRYPTEDTITLE TEXT, ZPATH TEXT, ZUNIQUEID TEXT,
            ZAUDIOFUTURE BLOB, ZVERSIONEDAUDIOFUTURE BLOB)''')
        self.db.commit()

    def tearDown(self):
        self.db.close()
        self.temporary.cleanup()

    def call(self, command, *extra, expected=0):
        result = subprocess.run([str(HELPER), command, '--library', str(self.library), *extra], capture_output=True, text=True)
        self.assertEqual(result.returncode, expected, result.stderr)
        return json.loads(result.stdout) if result.stdout.strip() else None

    def audio(self, name='fixture.wav', old=True):
        file = self.library / name
        with wave.open(str(file), 'wb') as audio:
            audio.setnchannels(1)
            audio.setsampwidth(2)
            audio.setframerate(16000)
            audio.writeframes(b'\0\0' * 16000)
        if old:
            os.utime(file, (time.time() - 600, time.time() - 600))
        return file

    def recording(self, identifier='fixture-id', flags=4, path='fixture.wav', duration=1.0):
        self.db.execute('''INSERT INTO ZCLOUDRECORDING
            (ZFLAGS,ZSHAREDFLAGS,ZAUDIOFUTUREFLAGS,ZDATE,ZDURATION,ZLOCALDURATION,
             ZCUSTOMLABEL,ZENCRYPTEDTITLE,ZPATH,ZUNIQUEID)
            VALUES (?,0,0,700000000,?,?, 'Synthetic fixture', 'Synthetic fixture', ?,?)''',
            (flags, duration, duration, path, identifier))
        self.db.commit()

    def hashes(self):
        return {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in self.library.iterdir() if p.is_file()}

    def test_wal_snapshot_does_not_modify_source_or_expose_rows(self):
        self.audio()
        self.recording()
        before = self.hashes()
        result = self.call('inspect')
        self.assertEqual(result['aggregate']['recordings'], 1)
        self.assertNotIn('Synthetic fixture', json.dumps(result))
        self.assertNotIn('fixture-id', json.dumps(result))
        self.assertEqual(before, self.hashes())

    def test_unknown_schema_fails_closed(self):
        self.db.execute('DROP TABLE ZCLOUDRECORDING')
        self.db.execute('CREATE TABLE UNRECOGNIZED (id TEXT)')
        self.db.commit()
        self.call('inventory', expected=1)

    def test_ready_inventory_and_atomic_original_copy(self):
        original = self.audio()
        self.recording()
        before = self.hashes()
        inventory = self.call('inventory')
        self.assertTrue(inventory['catalogueRecognized'])
        self.assertEqual(len(inventory['recordings']), 1)
        self.assertTrue(inventory['recordings'][0]['ready'])
        output = self.root / 'preserved.wav'
        receipt = self.call('copy', '--id', 'fixture-id', '--output', str(output))
        self.assertEqual(receipt['recording'], inventory['recordings'][0])
        self.assertEqual(output.read_bytes(), original.read_bytes())
        self.assertEqual(receipt['sha256'], hashlib.sha256(output.read_bytes()).hexdigest())
        self.assertEqual(before, self.hashes())
        self.call('copy', '--id', 'fixture-id', '--output', str(output), expected=1)

    def test_missing_recent_and_truncated_audio_defer(self):
        self.recording(identifier='missing', path='missing.wav')
        self.audio('recent.wav', old=False)
        self.recording(identifier='recent', path='recent.wav')
        self.audio('short.wav')
        self.recording(identifier='short', path='short.wav', duration=100)
        inventory = self.call('inventory')['recordings']
        self.assertEqual(len(inventory), 3)
        self.assertTrue(all(not row['ready'] for row in inventory))
        self.call('copy', '--id', 'missing', '--output', str(self.root / 'missing-copy.wav'), expected=75)

    def test_unknown_flags_and_paths_outside_library_defer(self):
        self.audio()
        self.recording(identifier='unknown-flags', flags=1 << 60)
        outside = self.root / 'outside.wav'
        outside.write_bytes((self.library / 'fixture.wav').read_bytes())
        (self.library / 'link.wav').symlink_to(outside)
        self.recording(identifier='symlink', path='link.wav')
        self.recording(identifier='traversal', path='../outside.wav')
        self.assertTrue(all(not row['ready'] for row in self.call('inventory')['recordings']))

    def test_copy_cannot_write_into_source_library(self):
        self.audio()
        self.recording()
        self.call('copy', '--id', 'fixture-id', '--output', str(self.library / 'copy.wav'), expected=1)
        self.assertFalse((self.library / 'copy.wav').exists())

    def test_deleted_recordings_are_excluded(self):
        self.audio()
        self.recording()
        self.db.execute('UPDATE ZCLOUDRECORDING SET ZEVICTIONDATE=700000001')
        self.db.commit()
        self.assertEqual(self.call('inventory')['recordings'], [])
        self.call('copy', '--id', 'fixture-id', '--output', str(self.root / 'deleted.wav'), expected=75)

    def test_download_export_and_unplayable_flags_defer(self):
        self.audio()
        for flags in [0, 2 | 4, 256 | 4]:
            self.recording(identifier=f'flags-{flags}', flags=flags)
        self.assertTrue(all(not row['ready'] for row in self.call('inventory')['recordings']))

    def test_observed_complete_flags_and_title_precedence(self):
        self.audio()
        for flags in [4, 1540, 5636]:
            self.recording(identifier=f'flags-{flags}', flags=flags)
        self.db.execute("UPDATE ZCLOUDRECORDING SET ZCUSTOMLABEL='Legacy title', ZENCRYPTEDTITLE='Synced title'")
        self.db.commit()
        records = self.call('inventory')['recordings']
        self.assertTrue(all(row['ready'] for row in records))
        self.assertTrue(all(row['title'] == 'Synced title' for row in records))
        self.db.execute('UPDATE ZCLOUDRECORDING SET ZENCRYPTEDTITLE=NULL')
        self.db.commit()
        self.assertTrue(all(row['title'] == 'Legacy title' for row in self.call('inventory')['recordings']))

    def test_partial_schema_and_empty_recognized_library(self):
        self.assertEqual(self.call('inventory')['recordings'], [])
        self.db.execute('ALTER TABLE ZCLOUDRECORDING RENAME COLUMN ZEVICTIONDATE TO unknown')
        self.db.commit()
        self.call('inventory', expected=1)

    def test_duplicate_ids_are_rejected(self):
        self.audio()
        self.recording()
        self.recording()
        self.call('inventory', expected=1)

    def test_launcher_restricts_commands(self):
        result = subprocess.run([str(HELPER), 'run', '--node', '/usr/bin/true', '--cli', '/tmp/cli', '--config', '/tmp/config', 'doctor'], capture_output=True)
        self.assertEqual(result.returncode, 1)


if __name__ == '__main__':
    unittest.main()
